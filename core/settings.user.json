{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "outputStyle": "kit-lean",
  "subagentPromptCacheTtl": "1h",
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "PONYTAIL_SUBAGENT_MATCHER": "^(builder|debugger)$"
  },
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(attrib -R:*)",
      "Bash(chmod +w:*)",
      "Bash(chmod a+w:*)",
      "Bash(chmod u+w:*)"
    ],
    "deny": [
      "Agent(model:fable)",
      "Agent(model:claude-fable-5-1)"
    ]
  }
}
