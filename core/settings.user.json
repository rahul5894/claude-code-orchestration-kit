{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(attrib -R:*)",
      "Bash(chmod +w:*)",
      "Bash(chmod a+w:*)",
      "Bash(chmod u+w:*)"
    ],
    "deny": [
      "Edit(.claude/scratch/*/briefs/**)",
      "Write(.claude/scratch/*/briefs/**)",
      "Edit(.claude/scratch/_closed/**)",
      "Write(.claude/scratch/_closed/**)"
    ]
  }
}
